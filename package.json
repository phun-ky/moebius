{
  "name": "@phun-ky/moebius",
  "version": "2.3.0",
  "description": "@phun-ky/moebius is a versatile JavaScript library that automatically generates visually pleasing and customizable color palettes from a given base color. Whether you're building data visualizations, UIs, or design systems, Möbius offers various harmony modes (analogous, complementary, triadic, and more), smooth interpolation, luminance shifts, and diverging palette generation - all with extensive color format support and intuitive API design.",
  "keywords": [
    "color",
    "colors",
    "palette",
    "palettes",
    "color-palette",
    "color-generator",
    "palette-generator",
    "color-scheme",
    "color-schemes",
    "design",
    "ui-design",
    "css",
    "javascript",
    "typescript",
    "color-theory",
    "color-harmony",
    "analogous",
    "complementary",
    "split-complementary",
    "triad",
    "triadic",
    "tetrad",
    "tetradic",
    "pentad",
    "pentadic",
    "hexad",
    "hexadic",
    "monochrome",
    "monochromatic",
    "interpolate",
    "luminance",
    "diverging",
    "chroma",
    "chromatic",
    "color-manipulation",
    "color-utils",
    "accessibility",
    "a11y",
    "visualization",
    "data-visualization",
    "theme-generator",
    "web-design",
    "creative-coding"
  ],
  "homepage": "https://github.com/phun-ky/moebius#readme",
  "bugs": {
    "url": "https://github.com/phun-ky/moebius/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phun-ky/moebius.git"
  },
  "license": "MIT",
  "author": "Alexander Vassbotn Røyne-Helgesen <alexander+github.com@phun-ky.net>",
  "type": "module",
  "main": "dist/moebius.js",
  "types": "dist/types/main.d.ts",
  "files": [
    "/dist/moebius.js",
    "/dist/moebius.js.map",
    "/dist/types",
    "/CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "bestpractices:url": "node scripts/bestpractices-url.mjs",
    "build": "npm run clean && npm run rollup && node scripts/fix-declaration-imports.mjs",
    "check:bestpractices": "node scripts/check-bestpractices.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "clean": "rm -rf dist dts",
    "commit": "npx git-cz",
    "docs:gen": "node ./node_modules/.bin/typedoc",
    "predocs:dev": "npm run docs:gen",
    "docs:dev": "vitepress dev docs",
    "docs:check": "typedoc --emit none --treatWarningsAsErrors && node scripts/check-docs-examples.mjs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "release": "release-it",
    "release:dry-run": ".github/scripts/should-release.sh && release-it --ci --dry-run --github.release=false --no-git.requireCleanWorkingDir --no-git.requireUpstream",
    "prepare": "git config core.hooksPath .githooks || true",
    "rollup": "rollup -c",
    "prewatch": "npm run clean",
    "watch": "rollup -c -w",
    "style:code": "npx putout src",
    "style:format": "eslint . --fix && prettier --write src",
    "style:lint": "eslint . && prettier --check src",
    "test": "npm run test:unit",
    "typecheck": "tsc --noEmit",
    "pretest:ci": "rm -rf coverage && mkdir -p coverage",
    "test:ci": "node --import tsx --import global-jsdom/register --enable-source-maps --test --no-warnings --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/**/__tests__/**' --test-coverage-exclude='src/types/**' --test-coverage-lines=94 --test-coverage-branches=92 --test-coverage-functions=99 --test-reporter=cobertura --test-reporter-destination=coverage/cobertura-coverage.xml --test-reporter=spec --test-reporter-destination=stdout 'src/**/__tests__/**/*.[jt]s'",
    "test:unit": "node --import tsx --import global-jsdom/register --test --no-warnings 'src/**/__tests__/**/*.[jt]s'"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/git-cz"
    }
  },
  "dependencies": {
    "@phun-ky/typeof": "^3.0.8",
    "chroma-js": "^3.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@release-it/conventional-changelog": "^12.0.2",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/chroma-js": "^3.1.2",
    "@types/node": "^24.19.2",
    "cobertura": "^1.0.1",
    "eslint": "^10.0.0",
    "eslint-config-phun-ky": "^2.0.10",
    "fast-check": "^4.10.2",
    "git-cz": "^4.9.0",
    "global-jsdom": "^29.0.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.0",
    "nearest-color": "^0.4.4",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "putout": "^42.11.0",
    "release-it": "^21.1.1",
    "remark-github": "^12.0.0",
    "remark-toc": "^9.0.0",
    "rollup": "^4.64.3",
    "rollup-plugin-typescript2": "^0.37.0",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typedoc-plugin-mdn-links": "^5.0.10",
    "typedoc-plugin-remark": "^2.0.2",
    "typedoc-plugin-rename-defaults": "^0.7.1",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "^6.0.3",
    "unified-prettier": "^2.0.1",
    "vitepress": "^1.6.4",
    "vitepress-plugin-group-icons": "^1.7.6"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "overrides": {
    "get-uri": {
      "basic-ftp": "^6.2.3"
    },
    "micromark-extension-math": {
      "katex": "^0.18.2"
    },
    "release-it": {
      "undici": "^7.30.1"
    },
    "vitepress": {
      "vite": "^6.4.5"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
